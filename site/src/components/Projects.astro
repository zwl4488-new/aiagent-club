---
import Base from '../layouts/Base.astro'
import Index from './Index.astro'
import { buildProjects, splitProjectIndex } from '../lib/projects.mjs'
import { t } from '../lib/i18n.mjs'

// props: locale
const { locale = 'en' } = Astro.props
const s = t(locale)
const base = locale === 'zh' ? '/zh' : ''
const path = locale === 'zh' ? '/zh/projects' : '/projects'
const otherPath = locale === 'zh' ? '/projects' : '/zh/projects'

const all = await buildProjects()
const { ranked, observed } = splitProjectIndex(all)
const projects = ranked.slice(0, 200)
const observationRows = observed.filter((project) => project.coverage > 0).slice(0, 200)
const title = `${s.index.title} | aiagent.club`
---
<Base locale={locale} title={title} description={s.index.note} path={path} altEn={locale === 'zh' ? otherPath : path} altZh={locale === 'zh' ? path : otherPath}>
  <h1 class="page-title">{s.index.title}</h1>


  <p class="intro">{s.index.full1(ranked.length, all.length)}</p>
  <p class="index-version">{s.index.version(all[0]?.methodologyVersion ?? '2.0', all[0]?.snapshot ?? '—')}</p>
  <Index title={s.index.title} note={s.index.note} rows={projects} s={s} base={base} />

  {observationRows.length > 0 && (
    <Index
      title={`${s.index.observationTitle} · ${observed.length}`}
      note={s.index.observationNote}
      rows={observationRows}
      s={s}
      base={base}
      mode="observed"
    />
  )}

  <p class="browse-cta"><a href={`${base}/`}>{s.detail.backHome}</a></p>
  <footer class="site">{s.footer}</footer>
</Base>
