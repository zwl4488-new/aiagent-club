---
import Base from '../layouts/Base.astro'
import Index from './Index.astro'
import { buildProjects } from '../lib/projects.mjs'
import { buildCategoryRankings, categoryBySlug } from '../lib/categories.mjs'
import { t } from '../lib/i18n.mjs'

const { locale = 'en', slug } = Astro.props
const s = t(locale)
const base = locale === 'zh' ? '/zh' : ''
const definition = categoryBySlug(slug)
if (!definition) throw new Error(`Unknown category: ${slug}`)
const category = buildCategoryRankings(await buildProjects()).find((row) => row.slug === slug)
const rows = category?.projects || []
const path = `${base}/category/${slug}`
const otherPath = locale === 'zh' ? `/category/${slug}` : `/zh/category/${slug}`
const name = s.categories.names[slug]
const description = s.categories.descriptions[slug]
const title = `${name} — ${s.categories.title} | aiagent.club`
const jsonld = {
  '@type': 'CollectionPage',
  name,
  description,
  url: `https://www.aiagent.club${path}`,
  mainEntity: { '@type': 'ItemList', numberOfItems: rows.length, itemListElement: rows.slice(0, 20).map((p, i) => ({ '@type': 'ListItem', position: i + 1, name: p.name, url: `https://www.aiagent.club${base}/project/${p.slug}/` })) },
}
---
<Base locale={locale} title={title} description={description} path={path} altEn={locale === 'zh' ? otherPath : path} altZh={locale === 'zh' ? path : otherPath} jsonld={jsonld}>
  <nav class="crumb"><a href={`${base}/categories`}>{s.categories.back}</a></nav>
  <header class="category-detail-head">
    <span class="category-symbol" aria-hidden="true">{definition.icon}</span>
    <div><h1 class="page-title">{name}</h1><p class="intro">{description}</p><p class="taxonomy-note">{s.categories.inferred}</p></div>
  </header>
  <Index title={`${name} · ${rows.length}`} note={s.index.note} rows={rows} s={s} base={base} />
  <footer class="site">{s.footer}</footer>
</Base>
