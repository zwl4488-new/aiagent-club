---
import Base from '../layouts/Base.astro'
import { t } from '../lib/i18n.mjs'

const { locale = 'en' } = Astro.props
const s = t(locale)
const base = locale === 'zh' ? '/zh' : ''
const path = locale === 'zh' ? '/zh/methodology' : '/methodology'
const otherPath = locale === 'zh' ? '/methodology' : '/zh/methodology'

const C = {
  en: {
    eyebrow: 'A READER’S GUIDE',
    title: 'How to read the Agent Index',
    intro: 'Use aiagent.club to find projects worth a closer look—not as a final verdict. Index v2 ranks only projects with current evidence across multiple source types, so one large or outdated number cannot tell the whole story.',
    summary: [
      { h: 'Best for', p: 'Building a shortlist, spotting breakout projects, and comparing traction on the same observable signals.' },
      { h: 'Read together', p: 'Look at the score, its three components, source coverage, freshness, and recent change—not the rank alone.' },
      { h: 'Not a verdict', p: 'A high score means stronger relative traction. It does not certify code quality, security, or fit for your use case.' },
    ],
    signalTitle: 'What goes into the score',
    signalIntro: 'Every software project is evaluated on three dimensions. An observation counts only when it is no more than two days behind the latest scoring snapshot; stale and missing values do not enter the score.',
    signals: [
      { key: 'adoption', pct: 45, h: 'Observed adoption', p: 'Weekly npm downloads and monthly PyPI downloads, normalized to a monthly scale for comparison.', note: 'Useful as an adoption proxy; it can include CI, mirrors, caches, and automated traffic.' },
      { key: 'momentum', pct: 30, h: 'Momentum', p: 'The project’s trailing seven-day GitHub star gain, measured from the daily time series.', note: 'Shows what is accelerating now rather than rewarding only projects that started early.' },
      { key: 'attention', pct: 25, h: 'Attention', p: 'The project’s current GitHub star count, used as a public signal of awareness and interest.', note: 'Stars measure attention, not active users, production deployments, or satisfaction.' },
    ],
    formulaTitle: 'How the calculation works',
    formulaSteps: [
      'For each unified project, the latest usable observations are checked against a two-day freshness window.',
      'To enter the main index, a project needs at least two current dimensions across at least two source types. Other tracked projects stay visible in the Observation pool without a formal rank.',
      'Each dimension becomes a percentile from 0 to 100 within the qualifying cross-source cohort.',
      'The percentiles are blended: 45% adoption + 30% momentum + 25% attention.',
      'A missing dimension scores zero. Its weight is not reassigned to the signals a project already has.',
    ],
    relative: 'The score is relative, not a grade or probability. It can move when a project changes, when its peers change, or when a new source is linked.',
    identityTitle: 'What one “project” represents',
    identityBody: 'A project page may combine a GitHub repository with its npm or PyPI packages when source metadata identifies them as the same product. Multiple packages from the same registry use the largest current adoption value rather than being added together. Source sections show the records that support the score and link to their metrics and trend.',
    categoryBody: 'Category labels are inferred from public names and descriptions. A project may appear in several categories, and categories do not affect its score.',
    useTitle: 'A practical way to use the site',
    useSteps: [
      { h: 'Discover', p: 'Start with the overall index or a category to find a manageable set of candidates.' },
      { h: 'Compare', p: 'Open the project pages and compare adoption, momentum, attention, and source coverage side by side.' },
      { h: 'Verify', p: 'Follow a source record to inspect its current value and history; check Data status for freshness.' },
      { h: 'Follow', p: 'Add candidates to your Watchlist or use the weekly feed to catch changes instead of rechecking every day.' },
    ],
    independenceEyebrow: 'INDEPENDENT BY DESIGN',
    independenceTitle: 'What keeps the ranking independent',
    independenceBody: 'Projects do not need to be claimed or paid for to be ranked. Owners cannot edit their score, and sponsorship or self-reported claims are not inputs to the formula. The score is calculated only from public records already tracked by the site.',
    freshnessBody: 'Collection is scheduled twice daily, while each metric keeps one value per day. A partial run does not invalidate records that were collected successfully; a missed record keeps its history but ages out of the score after two days. Partial and failed runs are shown on Data status. Same-day reruns, documented backfills, identity merges, or corrections may update a record.',
    limitsTitle: 'Limits you should keep in mind',
    limits: [
      'Observed adoption is not the same as active users, revenue, retention, or production usage.',
      'Download windows and platform definitions differ; figures from different sources should not be treated as identical measurements.',
      'OpenRouter throughput reflects activity on OpenRouter, not the entire model market.',
      'Newly discovered or single-source projects remain in the Observation pool until enough current, cross-source evidence is available.',
      'Automated categories can be imperfect. Treat them as discovery filters, then check the project itself.',
    ],
    verifyTitle: 'Want to inspect the evidence?',
    verifyBody: 'The data page shows source coverage, freshness, and collector health. Every project page links back to its source records, and the collectors are available in the public repository.',
    data: 'Open data status',
    categories: 'Browse categories',
    code: 'Inspect collectors',
  },
  zh: {
    eyebrow: '用户阅读指南',
    title: '如何读懂 Agent 指数',
    intro: '把 aiagent.club 当作筛选值得进一步了解项目的起点，而不是最终裁决。Index v2 只会正式排名拥有多类当前证据的项目，避免一个巨大或陈旧的数字讲完整个故事。',
    summary: [
      { h: '适合用来', p: '建立候选清单、发现正在起势的项目，并用统一的可观测信号比较市场牵引力。' },
      { h: '要一起看', p: '不要只看排名；同时查看综合分、三个分项、来源覆盖、新鲜度和近期变化。' },
      { h: '不是认证', p: '高分表示相对牵引力更强，不代表代码质量、安全性，也不代表一定适合你的场景。' },
    ],
    signalTitle: '综合分由什么组成',
    signalIntro: '每个软件项目都会检查三个维度。只有距最新评分快照不超过 2 天的观测才算当前有效；过期或缺失值不进入评分。',
    signals: [
      { key: 'adoption', pct: 45, h: '可观测采用度', p: '使用 npm 周下载量与 PyPI 月下载量，并统一换算到月度口径进行比较。', note: '它是采用度代理，可能包含 CI、镜像、缓存和自动化流量。' },
      { key: 'momentum', pct: 30, h: '增长动量', p: '根据每日时序计算项目过去 7 天的 GitHub Star 增量。', note: '它关注“现在谁在加速”，不会只奖励起步更早的项目。' },
      { key: 'attention', pct: 25, h: '关注度', p: '使用项目当前的 GitHub Star 数，作为公开可见的认知与兴趣信号。', note: 'Star 反映关注，不等于活跃用户、生产部署或用户满意度。' },
    ],
    formulaTitle: '分数如何计算',
    formulaSteps: [
      '对每个统一项目的最新观测执行 2 天新鲜度检查。',
      '进入主榜至少需要两个当前维度，且覆盖至少两种数据源；其他已追踪项目保留在观察池，不设正式名次。',
      '每个维度在满足跨来源门槛的项目组内换算成 0–100 百分位。',
      '按采用度 45% + 动量 30% + 关注度 25% 合成综合分。',
      '缺失维度按 0 分计算，不会把它的权重转给项目已有的强项。',
    ],
    relative: '综合分是相对位置，不是等级或成功概率。项目自身变化、其他项目变化，或新数据源被正确关联，都可能让分数移动。',
    identityTitle: '一条“项目”记录代表什么',
    identityBody: '当来源元数据能够确认它们属于同一产品时，一个项目页会把 GitHub 仓库与对应的 npm 或 PyPI 软件包合并展示。同一 registry 下的多个软件包取当前采用量最大值，而不是直接相加。来源区块可继续查看底层指标和趋势。',
    categoryBody: '分类标签由公开名称和简介自动推断。同一项目可能进入多个分类；分类只用于发现，不参与计分。',
    useTitle: '更有效的使用方式',
    useSteps: [
      { h: '发现', p: '从综合指数或分类榜开始，把候选范围缩小到可研究的数量。' },
      { h: '比较', p: '打开项目页，并排比较采用度、动量、关注度与来源覆盖。' },
      { h: '验证', p: '进入来源记录查看当前值和历史趋势，并在“数据状态”检查新鲜度。' },
      { h: '跟踪', p: '把候选项目加入关注清单，或订阅周报，不必每天重新翻榜。' },
    ],
    independenceEyebrow: '独立排名机制',
    independenceTitle: '排名为什么不依赖项目方',
    independenceBody: '项目无需认领或付费即可参与排名。项目方不能修改得分，赞助和自报数据也不会进入公式；得分只根据站内已经追踪的公开记录计算。',
    freshnessBody: '采集任务计划每天运行两次，每项指标按日保留一个值。部分成功不会废弃本轮已成功采到的记录；漏采记录保留历史，但超过 2 天后会退出评分。部分成功与失败运行会在“数据状态”如实显示；同日重跑、注明的回填、身份合并或数据修正可能更新记录。',
    limitsTitle: '使用时需要记住的边界',
    limits: [
      '可观测采用度不等于活跃用户、收入、留存或真实生产使用量。',
      '不同平台的下载窗口与统计定义不同，不应把跨平台数字当成完全相同的测量。',
      'OpenRouter 吞吐量只反映 OpenRouter 平台，不代表整个模型市场。',
      '新收录或只有单一来源的项目会留在观察池，直到具备足够的当前跨来源证据。',
      '自动分类可能出错。请把分类当作发现入口，再进入项目页核实。',
    ],
    verifyTitle: '想自己检查证据？',
    verifyBody: '“数据状态”会展示来源覆盖、新鲜度和采集健康；每个项目页都能继续打开来源记录，采集器代码也在公开仓库中。',
    data: '查看数据状态',
    categories: '浏览分类榜',
    code: '查看采集器',
  },
}

const c = C[locale] ?? C.en
const title = `${c.title} | aiagent.club`
---
<Base locale={locale} title={title} description={c.intro} path={path} altEn={locale === 'zh' ? otherPath : path} altZh={locale === 'zh' ? path : otherPath}>
  <article class="method-page">
    <header class="method-hero">
      <p class="section-kicker">{c.eyebrow}</p>
      <h1>{c.title}</h1>
      <p>{c.intro}</p>
    </header>

    <section class="method-summary" aria-label={c.title}>
      {c.summary.map((item) => <div><h2>{item.h}</h2><p>{item.p}</p></div>)}
    </section>

    <section class="method-score">
      <div class="method-section-head"><h2>{c.signalTitle}</h2><p>{c.signalIntro}</p></div>
      <div class="method-score-grid">
        <div class="method-signals">
          {c.signals.map((signal) => (
            <article class={`method-signal signal-${signal.key}`}>
              <div class="method-signal-top"><span>{signal.pct}%</span><h3>{signal.h}</h3></div>
              <div class="method-weight"><i style={`width:${signal.pct}%`}></i></div>
              <p>{signal.p}</p><small>{signal.note}</small>
            </article>
          ))}
        </div>
        <aside class="method-formula">
          <h3>{c.formulaTitle}</h3>
          <ol>{c.formulaSteps.map((step) => <li>{step}</li>)}</ol>
          <p>{c.relative}</p>
        </aside>
      </div>
    </section>

    <div class="method-two-col">
      <section class="method-panel">
        <h2>{c.identityTitle}</h2>
        <p>{c.identityBody}</p>
        <p>{c.categoryBody}</p>
      </section>
      <section class="method-panel method-use">
        <h2>{c.useTitle}</h2>
        <ol>{c.useSteps.map((step, index) => <li><span>{index + 1}</span><div><h3>{step.h}</h3><p>{step.p}</p></div></li>)}</ol>
      </section>
    </div>

    <section class="method-independence">
      <div><p class="section-kicker">{c.independenceEyebrow}</p><h2>{c.independenceTitle}</h2></div>
      <div><p>{c.independenceBody}</p><p>{c.freshnessBody}</p></div>
    </section>

    <section class="method-limits">
      <h2>{c.limitsTitle}</h2>
      <ul>{c.limits.map((item) => <li>{item}</li>)}</ul>
    </section>

    <section class="method-verify">
      <div><h2>{c.verifyTitle}</h2><p>{c.verifyBody}</p></div>
      <nav aria-label={c.verifyTitle}>
        <a href={`${base}/data`}>{c.data}</a>
        <a href={`${base}/categories`}>{c.categories}</a>
        <a href="https://github.com/zwl4488-new/aiagent-club">{c.code} ↗</a>
      </nav>
    </section>
  </article>
  <footer class="site">{s.footer}</footer>
</Base>
