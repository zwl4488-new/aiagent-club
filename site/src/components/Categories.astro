---
import Base from '../layouts/Base.astro'
import { buildProjects, splitProjectIndex } from '../lib/projects.mjs'
import { buildCategoryRankings } from '../lib/categories.mjs'
import { t } from '../lib/i18n.mjs'

const { locale = 'en' } = Astro.props
const s = t(locale)
const base = locale === 'zh' ? '/zh' : ''
const path = `${base}/categories`
const otherPath = locale === 'zh' ? '/categories' : '/zh/categories'
const { ranked } = splitProjectIndex(await buildProjects())
const categories = buildCategoryRankings(ranked)
const title = `${s.categories.title} | aiagent.club`
---
<Base locale={locale} title={title} description={s.categories.intro} path={path} altEn={locale === 'zh' ? otherPath : path} altZh={locale === 'zh' ? path : otherPath}>
  <header class="section-intro">
    <p class="section-kicker">AI AGENT TAXONOMY</p>
    <h1 class="page-title">{s.categories.title}</h1>
    <p class="intro">{s.categories.intro}</p>
    <p class="taxonomy-note">{s.categories.inferred}</p>
  </header>

  <div class="category-grid">
    {categories.map((category) => (
      <article class="category-card">
        <div class="category-card-head"><span aria-hidden="true">{category.icon}</span><small>{category.projects.length} {s.categories.projects}</small></div>
        <h2><a href={`${base}/category/${category.slug}`}>{s.categories.names[category.slug]}</a></h2>
        <p>{s.categories.descriptions[category.slug]}</p>
        <div class="category-top">
          <b>{s.categories.top}</b>
          <ol>
            {category.projects.slice(0, 3).map((project) => (
              <li><a href={`${base}/project/${project.slug}`}>{project.name}</a><span>{project.score}</span></li>
            ))}
          </ol>
        </div>
        <a class="category-open" href={`${base}/category/${category.slug}`}>{s.categories.open} →</a>
      </article>
    ))}
  </div>

  <p class="browse-cta"><a href={`${base}/methodology`}>{s.categories.methodology} →</a></p>
  <footer class="site">{s.footer}</footer>
</Base>
